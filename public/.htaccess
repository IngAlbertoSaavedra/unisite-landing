# SPA Vue Router /unisite/ | Hostinger/Apache
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /unisite/
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule . /unisite/index.html [L]
</IfModule>

# El carrusel se actualiza por n8n sin npm run build.
<IfModule mod_headers.c>
  <FilesMatch "^avisos\.json$">
    Header always set Cache-Control "no-store, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
