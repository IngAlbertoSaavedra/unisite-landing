      "id": "004e32b4-084f-5065-b971-3fad10132396",
      "name": "Validar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -550,
        50
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const incoming = $input.first().json || {};\nlet b = incoming.body || {};\nif (typeof b === 'string') {\n  b = Object.fromEntries(b.split('&').map(pair => {\n    const i = pair.indexOf('=');\n    const d = x => decodeURIComponent(String(x||'').replace(/\\+/g,' '));\n    return [d(pair.slice(0,i)),d(pair.slice(i+1))];\n  }));\n}\nconst t=(field,max) => String(b[field] ?? '').trim().slice(0,max);\nconst email=t('correo',160);\nconst phone=t('telefono',30).replace(/[^\\d+\\s()-]/g,'');\nconst token=t('turnstileToken',2048);\nconst tipo=t('tipo',30);\nconst honeypot=t('empresa',100);\nconst valido = !honeypot && ['informes','admisiones'].includes(tipo) &&\n t('nombre',110).length>=3 && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) &&\n phone.replace(/\\D/g,'').length>=10 && !!t('programa',180) &&\n t('consentimiento',10)==='true' && token.length>10 &&\n (tipo!=='admisiones' || !!t('nivel',70));\nreturn [{json:{valido,tipo,nombre:t('nombre',110),correo:email,telefono:phone,programa:t('programa',180),\n nivel:t('nivel',70),modalidad:t('modalidad',70),horario:t('horario',70),mensaje:t('mensaje',1200),\n origen:'PKS_UNISITE_LANDING',token}}];"
      }
    },
