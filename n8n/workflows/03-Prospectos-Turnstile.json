      "name": "Preparar fila",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        -150
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Validar solicitud').first().json;\n// Evitar inyección de fórmulas en Sheets, incluso si alguien altera el HTML del formulario.\nconst protect=(v)=> {let s=String(v||'');if (/^[\\s]*[=+\\-@]/.test(s)) s=\"'\"+s;return s;};\nreturn [{json:{\n id:`un-${Date.now()}-${Math.floor(Math.random()*10000)}`,\n fecha:new Date().toISOString(),\n tipo:p.tipo,nombre:protect(p.nombre),correo:protect(p.correo),telefono:protect(p.telefono),\n programa:protect(p.programa),nivel:protect(p.nivel),modalidad:protect(p.modalidad),horario:protect(p.horario),\n mensaje:protect(p.mensaje),origen:p.origen,consentimiento:'Si',estado:'Nuevo'\n}}];"
      }
