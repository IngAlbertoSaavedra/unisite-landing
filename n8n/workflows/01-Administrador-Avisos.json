    {
      "id": "4469415c-6262-5cf2-91d1-b63a2d0a4771",
      "name": "Crear JSON público",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// El exportador publica ÚNICAMENTE avisos activos en la fecha local México.\n// No incluir borradores ni avisos futuros en el JSON que ve el visitante.\nconst rows = $input.all().map(item => item.json).filter(row => row && row.id);\nconst formatter = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit'\n});\nconst parts = formatter.formatToParts(new Date());\nconst today = `${parts.find(p => p.type === 'year').value}-${parts.find(p => p.type === 'month').value}-${parts.find(p => p.type === 'day').value}`;\nconst cleanUrl = (raw) => {\n  const value = String(raw || '').trim();\n  if (value.startsWith('/') && !value.startsWith('//')) return value;\n  try { const u = new URL(value); return ['https:', 'http:'].includes(u.protocol) ? u.toString() : ''; }\n  catch { return ''; }\n};\nconst avisos = rows.filter(r => {\n  const status = String(r.estado || '').trim().toLowerCase();\n  const start = String(r.inicio || '').slice(0,10);\n  const end = String(r.fin || '').slice(0,10);\n  return status === 'publicado' && (!start || start <= today) && (!end || end >= today);\n}).map(r => ({\n  id: String(r.id),\n  titulo: String(r.titulo || '').slice(0,110),\n  resumen: String(r.resumen || '').slice(0,230),\n  categoria: String(r.categoria || 'AVISO').slice(0,32),\n  imagen: cleanUrl(r.imagen),\n  enlace: cleanUrl(r.enlace),\n  fecha: String(r.inicio || '').slice(0,10),\n  orden: Number(r.orden) || 50\n})).filter(r => r.titulo).sort((a,b)=>a.orden-b.orden).slice(0,16);\nreturn [{ json: { actualizado: new Date().toISOString(), avisos } }];"
      }
