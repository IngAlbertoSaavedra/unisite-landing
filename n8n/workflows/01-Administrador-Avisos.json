    {
      "id": "dce74329-ae58-504b-8276-cea03dc350e5",
      "name": "Normalizar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -730,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// IMPORTANTE: el formulario está protegido por Basic Auth.\nconst original = $input.first();\nconst r = original.json || {};\nconst text = (v,n) => String(v ?? '').trim().slice(0,n);\nconst accion = text(r.accion,40).toLowerCase();\nif (!['publicar','guardar borrador','desactivar'].includes(accion)) throw new Error('Acción no válida');\nconst codigo = text(r.id,60).replace(/[^a-zA-Z0-9_-]/g,'');\nif (accion === 'desactivar' && !codigo) throw new Error('Para desactivar, captura el ID actual del aviso');\nconst id = codigo || ('aviso-'+Date.now().toString(36)+'-'+Math.floor(Math.random()*10000).toString(36));\nconst binary = original.binary || {};\nconst key = Object.keys(binary)[0] || '';\nconst attached = key ? binary[key] : null;\nlet extension = '';\nif (attached) {\n  extension = ({ 'image/png':'png', 'image/jpeg':'jpg', 'image/webp':'webp' })[attached.mimeType] || '';\n  if (!extension) throw new Error('Solo se permiten imágenes JPG, PNG o WebP');\n  // El límite real de carga se controla en n8n / reverse proxy.\n}\nconst filename = `${id}-${Date.now()}.${extension}`;\nconst imagen = attached ? `https://ajsaavedra.com/unisite/avisos/${filename}` : text(r.imagenUrl,500);\nconst dateText = (v) => { const value=text(v,35).slice(0,10); return /^\\d{4}-\\d{2}-\\d{2}$/.test(value) ? value : ''; };\nreturn [{\n json:{ accion, id, titulo:text(r.titulo,110), resumen:text(r.resumen,230), categoria:text(r.categoria,32), imagen,\n enlace:text(r.enlace,500), inicio:dateText(r.inicio), fin:dateText(r.fin), orden:text(r.orden,4),\n estado: accion === 'desactivar' ? 'Desactivado' : accion === 'publicar' ? 'Publicado' : 'Borrador',\n tieneImagen:!!attached, nombreArchivo:filename },\n binary: attached ? { imagen:attached } : {}\n}];"
      }
    },
