    {
      "id": "b6a458f1-4916-5f4e-bef2-83a2586db8c3",
      "name": "Combinar aviso anterior",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Si se edita o desactiva, conservar las columnas no enviadas.\nconst form = $('Normalizar aviso').first().json;\nconst rows = $input.all().map(i=>i.json);\nconst previous = rows.find(r=>String(r.id||'')===form.id) || null;\nif (form.accion === 'desactivar' && !previous) throw new Error('ID no encontrado en Google Sheets');\nconst current = (field) => form[field] === '' ? (previous?.[field] ?? '') : form[field];\nconst result = {\n id:form.id,\n titulo:current('titulo'),\n resumen:current('resumen'),\n categoria:current('categoria') || 'INSTITUCIONAL',\n imagen:current('imagen'),\n enlace:current('enlace'),\n inicio:current('inicio'),\n fin:current('fin'),\n orden:current('orden') || 50,\n estado:form.estado,\n actualizado:new Date().toISOString()\n};\nif (!result.titulo) throw new Error('Captura un título para crear un nuevo aviso');\nif (result.inicio && result.fin && result.fin < result.inicio) throw new Error('La fecha final es anterior a la inicial');\nreturn [{json:result}];"
      }
    },
